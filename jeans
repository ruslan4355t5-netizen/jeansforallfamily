    <div id="auth-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="auth-title">
        <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative">
            <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-gray-500 hover:text-black dark:hover:text-white" aria-label="Закрыть"><i class="fa-solid fa-xmark text-xl"></i></button>
            <h3 id="auth-title" class="text-xl font-extrabold uppercase tracking-tight mb-1">Личный кабинет</h3>
            <p class="text-xs text-gray-500 mb-6">Войдите или создайте аккаунт, чтобы отслеживать заказы и избранное.</p>
            <div class="flex border-b border-gray-200 dark:border-gray-800 mb-6">
                <button id="auth-tab-login" onclick="switchAuthTab('login')" class="flex-1 pb-3 text-xs font-bold uppercase tracking-widest border-b-2 border-black dark:border-white text-black dark:text-white transition">Вход</button>
                <button id="auth-tab-register" onclick="switchAuthTab('register')" class="flex-1 pb-3 text-xs font-bold uppercase tracking-widest border-b-2 border-transparent text-gray-400 transition">Регистрация</button>
            </div>
            <form id="login-form" onsubmit="handleLogin(event)" class="space-y-3">
                <input type="email" id="login-email" required placeholder="Email" class="w-full bg-gray-100 dark:bg-gray-800 rounded px-4 py-2.5 text-xs focus:outline-none" autocomplete="email">
                <input type="password" id="login-password" required placeholder="Пароль" class="w-full bg-gray-100 dark:bg-gray-800 rounded px-4 py-2.5 text-xs focus:outline-none" autocomplete="current-password">
                <button type="submit" class="w-full bg-black text-white dark:bg-white dark:text-black py-3 text-xs font-bold uppercase tracking-widest hover:opacity-80 transition">Войти</button>
                <p id="login-error" class="hidden text-xs text-red-500 text-center">Неверный email или пароль</p>
            </form>
            <form id="register-form" onsubmit="handleRegister(event)" class="space-y-3 hidden">
                <input type="text" id="reg-name" required placeholder="Ваше имя" class="w-full bg-gray-100 dark:bg-gray-800 rounded px-4 py-2.5 text-xs focus:outline-none" autocomplete="name">
                <input type="email" id="reg-email" required placeholder="Email" class="w-full bg-gray-100 dark:bg-gray-800 rounded px-4 py-2.5 text-xs focus:outline-none" autocomplete="email">
                <input type="password" id="reg-password" required minlength="4" placeholder="Пароль (мин. 4 символа)" class="w-full bg-gray-100 dark:bg-gray-800 rounded px-4 py-2.5 text-xs focus:outline-none" autocomplete="new-password">
                <button type="submit" class="w-full bg-black text-white dark:bg-white dark:text-black py-3 text-xs font-bold uppercase tracking-widest hover:opacity-80 transition">Создать аккаунт</button>
                <p id="reg-error" class="hidden text-xs text-red-500 text-center">Пользователь с таким email уже существует</p>
            </form>
        </div>
    </div>

    <div id="account-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="acc-name">
        <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeAccountModal()" class="absolute top-4 right-4 text-gray-500 hover:text-black dark:hover:text-white" aria-label="Закрыть"><i class="fa-solid fa-xmark text-xl"></i></button>
            <div class="flex items-center space-x-4 mb-6">
                <div id="acc-avatar-large" class="w-14 h-14 rounded-full bg-black text-white dark:bg-white dark:text-black flex items-center justify-center text-xl font-extrabold uppercase">U</div>
                <div><h3 id="acc-name" class="text-lg font-extrabold uppercase tracking-tight">Пользователь</h3><p id="acc-email" class="text-xs text-gray-500">email@example.com</p></div>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-6 text-center">
                <div class="bg-gray-50 dark:bg-gray-800 rounded-lg py-3"><div id="acc-orders-count" class="text-lg font-extrabold">0</div><div class="text-[10px] uppercase tracking-wider text-gray-500">Заказов</div></div>
                <div class="bg-gray-50 dark:bg-gray-800 rounded-lg py-3"><div id="acc-fav-count" class="text-lg font-extrabold">0</div><div class="text-[10px] uppercase tracking-wider text-gray-500">В избранном</div></div>
                <div class="bg-gray-50 dark:bg-gray-800 rounded-lg py-3"><div id="acc-total-spent" class="text-lg font-extrabold">0 ₽</div><div class="text-[10px] uppercase tracking-wider text-gray-500">Потрачено</div></div>
            </div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">История заказов</h4>
            <div id="orders-list" class="space-y-3 mb-6"></div>
            <div class="space-y-2">
                <button onclick="closeAccountModal(); toggleFavoritesModal()" class="w-full border border-gray-300 dark:border-gray-700 py-3 text-xs font-bold uppercase tracking-widest rounded hover:bg-gray-100 dark:hover:bg-gray-800 transition"><i class="fa-regular fa-heart mr-2"></i> Моё избранное</button>
                <button onclick="logout()" class="w-full border border-red-300 text-red-600 py-3 text-xs font-bold uppercase tracking-widest rounded hover:bg-red-50 dark:hover:bg-red-950/30 transition"><i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Выйти из аккаунта</button>
            </div>
        </div>
    </div>

    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-black text-white dark:bg-white dark:text-black px-5 py-3 rounded-lg shadow-xl flex items-center space-x-3 text-xs font-semibold" role="status" aria-live="polite">
        <i class="fa-solid fa-circle-check text-green-400 dark:text-green-600 text-base"></i>
        <span id="toast-msg">Готово</span>
    </div>

    <script>
        // ===== PRODUCTS =====
        const products = [
            { id: 1, name: "Джинсы прямые Classic Denim", category: "Джинсы", price: 4900, oldPrice: 6500, isBestseller: true, isNew: true, sizes: ["S","M","L","XL"], colors: ["#1e3a5f","#111827","#6B7280"], description: "Прямые джинсы из плотного хлопкового денима 12 oz. Универсальная посадка на каждый день." },
            { id: 2, name: "Джинсы с завышенной посадкой", category: "Джинсы", price: 5900, oldPrice: null, isBestseller: true, isNew: false, sizes: ["XS","S","M","L"], colors: ["#1e3a5f","#111827"], description: "Модель с высокой посадкой и слегка зауженным кроем. Подчёркивает талию и вытягивает силуэт." },
            { id: 3, name: "Джинсы-оверсайз Wide Leg", category: "Джинсы", price: 6200, oldPrice: 7500, isBestseller: true, isNew: true, sizes: ["S","M","L","XL"], colors: ["#3b5a7a","#111827","#d1d5db"], description: "Свободные джинсы широкого кроя из мягкого денима. Комфорт и актуальный силуэт." },
            { id: 4, name: "Джинсы зауженные Slim Fit", category: "Джинсы", price: 4500, oldPrice: null, isBestseller: false, isNew: false, sizes: ["S","M","L"], colors: ["#111827","#1e3a5f"], description: "Зауженные джинсы с эластаном для комфортной посадки. Классика на каждый день." },
            { id: 5, name: "Джинсы рваные с потёртостями", category: "Джинсы", price: 5600, oldPrice: 6900, isBestseller: false, isNew: true, sizes: ["S","M","L","XL"], colors: ["#3b5a7a","#111827"], description: "Джинсы с декоративными потёртостями и рваными элементами. Городской стиль." },
            { id: 6, name: "Футболка-майка базовая", category: "Нижняя одежда", price: 1200, oldPrice: null, isBestseller: true, isNew: false, sizes: ["XS","S","M","L","XL"], colors: ["#ffffff","#111827","#9CA3AF"], description: "Базовая майка из 100% хлопка. Мягкая, дышащая, идеальна как первый слой." },
            { id: 7, name: "Термобельё комплект", category: "Нижняя одежда", price: 3400, oldPrice: 4200, isBestseller: true, isNew: true, sizes: ["S","M","L","XL"], colors: ["#111827","#6B7280"], description: "Комплект термобелья из эластичного хлопка с добавлением эластана. Сохраняет тепло." },
            { id: 8, name: "Боксеры хлопковые (3 шт.)", category: "Нижняя одежда", price: 1800, oldPrice: null, isBestseller: false, isNew: false, sizes: ["S","M","L","XL"], colors: ["#ffffff","#111827","#6B7280"], description: "Набор из трёх боксеров из мягкого хлопка. Удобный крой и дышащие материалы." },
            { id: 9, name: "Лонгслив базовый", category: "Нижняя одежда", price: 2100, oldPrice: 2600, isBestseller: false, isNew: true, sizes: ["S","M","L","XL"], colors: ["#ffffff","#111827"], description: "Тонкий базовый лонгслив из хлопка. Носится под свитера и рубашки." },
            { id: 10, name: "Комплект нижнего белья", category: "Нижняя одежда", price: 2600, oldPrice: null, isBestseller: false, isNew: false, sizes: ["XS","S","M","L"], colors: ["#111827","#d1d5db"], description: "Комплект из хлопкового трикотажа: топ и слипы. Комфорт на каждый день." }
        ];

        // ===== STATE =====
        let state = {
            cart: JSON.parse(localStorage.getItem('ut_cart') || '[]'),
            favorites: JSON.parse(localStorage.getItem('ut_favorites') || '[]'),
            selectedSizes: [],
            discountPercent: 0,
            activeTab: 'home',
            selectedModalSize: null,
            selectedModalProduct: null,
            currentProductId: null,
            searchQuery: ''
        };

        let currentUser = null;
        let users = JSON.parse(localStorage.getItem('ut_users') || '{}');

        // ===== PERSISTENCE =====
        function persistCart() { localStorage.setItem('ut_cart', JSON.stringify(state.cart)); }
        function persistFavorites() { localStorage.setItem('ut_favorites', JSON.stringify(state.favorites)); }
        function persistUsers() {
            localStorage.setItem('ut_users', JSON.stringify(users));
            localStorage.setItem('ut_current_user', currentUser ? currentUser.email : '');
        }
        function restoreSession() {
            const email = localStorage.getItem('ut_current_user');
            if (email && users[email]) currentUser = users[email];
            const theme = localStorage.getItem('ut_theme');
            if (theme === 'dark') document.documentElement.classList.add('dark');
        }

        // ===== ROUTER =====
        const routes = {
            '': 'home', '/': 'home', '/catalog': 'catalog', '/collections': 'collections',
            '/about': 'about', '/contacts': 'contacts', '/checkout': 'checkout', '/success': 'success'
        };

        function router() {
            const hash = location.hash.replace(/^#/, '') || '/';
            const [path, query] = hash.split('?');
            const params = new URLSearchParams(query || '');

            // product detail
            if (path.startsWith('/product/')) {
                const id = parseInt(path.split('/')[2], 10);
                const product = products.find(p => p.id === id);
                if (product) {
                    renderProductPage(product);
                    showTab('product');
                    return;
                } else {
                    showTab('404');
                    return;
                }
            }

            const tab = routes[path] || '404';
            showTab(tab);

            if (tab === 'catalog') {
                if (params.has('cat')) filterByCategory(params.get('cat'), true);
                if (params.has('sort')) { document.getElementById('sort-select').value = params.get('sort'); applyFilters(); }
            }
            if (tab === 'checkout') renderCheckout();
        }

        function showTab(tabId) {
            state.activeTab = tabId;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById(`tab-${tabId}`);
            if (target) target.classList.remove('hidden');
            document.querySelectorAll('.nav-link').forEach(link => {
                const isActive = link.getAttribute('data-tab') === tabId;
                link.classList.toggle('text-black', isActive);
                link.classList.toggle('dark:text-white', isActive);
                link.classList.toggle('border-black', isActive);
                link.classList.toggle('dark:border-white', isActive);
                link.classList.toggle('text-gray-500', !isActive);
                link.classList.toggle('dark:text-gray-400', !isActive);
                link.classList.toggle('border-transparent', !isActive);
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function switchTab(tabId) {
            const map = { home: '/', catalog: '/catalog', collections: '/collections', about: '/about', contacts: '/contacts', checkout: '/checkout', success: '/success' };
            if (map[tabId]) { location.hash = '#' + map[tabId]; }
        }

        window.addEventListener('hashchange', router);

        // ===== INIT =====
        document.addEventListener('DOMContentLoaded', () => {
            restoreSession();
            renderBestsellers();
            renderCatalog(products);
            updateCartUI();
            updateFavUI();
            updateAccountUI();
            router();
            bindGlobalEvents();
        });

        // ===== PRODUCT CARDS =====
        function createProductCardHTML(product) {
            const isFav = state.favorites.includes(product.id);
            return `
                <div class="group relative flex flex-col justify-between bg-white dark:bg-gray-900 rounded-xl overflow-hidden border border-gray-100 dark:border-gray-800 hover:shadow-lg transition duration-300">
                    <a href="#/product/${product.id}" class="relative aspect-[3/4] placeholder-card overflow-hidden flex items-center justify-center text-white/20" aria-label="${product.name}">
                        <i class="fa-solid fa-shirt text-6xl opacity-40"></i>
                        ${product.oldPrice ? `<span class="absolute top-3 left-3 bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase">Скидка</span>` : ''}
                        ${product.isNew ? `<span class="absolute bottom-3 left-3 bg-black text-white dark:bg-white dark:text-black text-[10px] font-bold px-2 py-0.5 rounded uppercase">New</span>` : ''}
                    </a>
                    <button onclick="event.preventDefault(); toggleFavorite(${product.id})" class="absolute top-3 right-3 z-20 p-2 rounded-full bg-white/80 dark:bg-gray-900/80 backdrop-blur text-gray-700 dark:text-gray-200 hover:text-red-500 transition" aria-label="В избранное" aria-pressed="${isFav}">
                        <i class="${isFav ? 'fa-solid fa-heart text-red-500' : 'fa-regular fa-heart'}"></i>
                    </button>
                    <div class="p-4 flex flex-col flex-grow justify-between">
                        <div>
                            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">${product.category}</span>
                            <a href="#/product/${product.id}" class="block text-xs sm:text-sm font-semibold text-gray-900 dark:text-gray-100 mt-1 hover:underline line-clamp-1">${product.name}</a>
                        </div>
                        <div class="mt-4 flex items-center justify-between">
                            <div>
                                <span class="text-sm font-extrabold text-black dark:text-white">${product.price.toLocaleString()} ₽</span>
                                ${product.oldPrice ? `<span class="text-xs text-gray-400 line-through ml-1">${product.oldPrice.toLocaleString()} ₽</span>` : ''}
                            </div>
                            <button onclick="addToCart(${product.id}, '${product.sizes[0]}')" class="p-2 bg-gray-100 dark:bg-gray-800 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black rounded-lg transition text-xs" aria-label="Добавить в корзину"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderBestsellers() {
            const bestsellers = products.filter(p => p.isBestseller);
            document.getElementById('home-bestsellers-grid').innerHTML = bestsellers.map(p => createProductCardHTML(p)).join('');
        }

        function renderCatalog(items) {
            const container = document.getElementById('catalog-grid');
            const emptyState = document.getElementById('catalog-empty');
            document.getElementById('catalog-count').innerText = items.length;
            if (items.length === 0) { container.innerHTML = ''; emptyState.classList.remove('hidden'); }
            else { emptyState.classList.add('hidden'); container.innerHTML = items.map(p => createProductCardHTML(p)).join(''); }
        }

        // ===== PRODUCT PAGE =====
        function renderProductPage(product) {
            state.currentProductId = product.id;
            state.selectedModalProduct = product;
            state.selectedModalSize = product.sizes[0];
            document.getElementById('product-breadcrumb').innerText = product.name;
            document.getElementById('product-category').innerText = product.category;
            document.getElementById('product-title').innerText = product.name;
            document.getElementById('product-price').innerText = `${product.price.toLocaleString()} ₽`;
            document.getElementById('product-desc').innerText = product.description;
            document.getElementById('product-colors').innerHTML = product.colors.map(c => `<div class="w-6 h-6 rounded-full border border-gray-300" style="background-color:${c}"></div>`).join('');
            document.getElementById('product-sizes').innerHTML = product.sizes.map(size => `
                <button onclick="selectProductSize('${size}', this)" class="product-size-btn px-4 py-2 border ${size === state.selectedModalSize ? 'border-black dark:border-white font-bold bg-gray-100 dark:bg-gray-800' : 'border-gray-200 dark:border-gray-700'} text-xs rounded">${size}</button>
            `).join('');
            document.getElementById('product-add-cart-btn').onclick = () => { addToCart(product.id, state.selectedModalSize); };
        }

        function selectProductSize(size, btn) {
            state.selectedModalSize = size;
            document.querySelectorAll('.product-size-btn').forEach(b => b.classList.remove('border-black','dark:border-white','font-bold','bg-gray-100','dark:bg-gray-800'));
            btn.classList.add('border-black','dark:border-white','font-bold','bg-gray-100','dark:bg-gray-800');
        }

        // ===== FILTERS =====
        function applyFilters() {
            let filtered = [...products];
            if (state.searchQuery) {
                const q = state.searchQuery.toLowerCase();
                filtered = filtered.filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
            }
            const selectedCategories = Array.from(document.querySelectorAll('.filter-category:checked')).map(cb => cb.value);
            if (!selectedCategories.includes('Все') && selectedCategories.length > 0) filtered = filtered.filter(p => selectedCategories.includes(p.category));
            const maxPrice = parseInt(document.getElementById('price-range').value, 10);
            filtered = filtered.filter(p => p.price <= maxPrice);
            if (state.selectedSizes.length > 0) filtered = filtered.filter(p => p.sizes.some(s => state.selectedSizes.includes(s)));
            const sortBy = document.getElementById('sort-select').value;
            if (sortBy === 'price-asc') filtered.sort((a,b) => a.price - b.price);
            else if (sortBy === 'price-desc') filtered.sort((a,b) => b.price - a.price);
            else if (sortBy === 'newest') filtered.sort((a,b) => (b.isNew?1:0) - (a.isNew?1:0));
            renderCatalog(filtered);
        }

        function filterByCategory(name, silent) {
            if (!silent) location.hash = '#/catalog?cat=' + encodeURIComponent(name);
            document.querySelectorAll('.filter-category').forEach(cb => { cb.checked = (cb.value === name); });
            applyFilters();
        }

        function filterByCollection(type) {
            resetFilters();
            if (type === 'sale') { renderCatalog(products.filter(p => p.oldPrice !== null)); return; }
            if (type === 'new') document.getElementById('sort-select').value = 'newest';
            applyFilters();
        }

        function toggleSizeFilter(btn, size) {
            btn.classList.toggle('bg-black'); btn.classList.toggle('text-white');
            btn.classList.toggle('dark:bg-white'); btn.classList.toggle('dark:text-black');
            if (state.selectedSizes.includes(size)) state.selectedSizes = state.selectedSizes.filter(s => s !== size);
            else state.selectedSizes.push(size);
            applyFilters();
        }

        function updatePriceLabel(val) { document.getElementById('price-range-val').innerText = `${parseInt(val,10).toLocaleString()} ₽`; }

        function resetFilters() {
            document.querySelectorAll('.filter-category').forEach(cb => { cb.checked = (cb.value === 'Все'); });
            document.getElementById('price-range').value = 15000; updatePriceLabel(15000);
            state.selectedSizes = [];
            document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('bg-black','text-white','dark:bg-white','dark:text-black'));
            document.getElementById('sort-select').value = 'popular';
            state.searchQuery = ''; document.getElementById('search-input').value = ''; document.getElementById('mobile-search-input').value = '';
            applyFilters();
        }

        function handleSearch(event) {
            state.searchQuery = event.target.value.trim();
            if (state.activeTab !== 'catalog') switchTab('catalog');
            applyFilters();
            renderSearchSuggestions(state.searchQuery);
        }

        function showSearchSuggestions() {
            renderSearchSuggestions(document.getElementById('search-input').value.trim());
        }
        function renderSearchSuggestions(q) {
            const box = document.getElementById('search-suggestions');
            if (!q) { box.classList.add('hidden'); return; }
            const matches = products.filter(p => p.name.toLowerCase().includes(q.toLowerCase())).slice(0, 5);
            if (matches.length === 0) { box.innerHTML = `<div class="p-3 text-xs text-gray-500">Ничего не найдено</div>`; }
            else {
                box.innerHTML = matches.map(p => `
                    <a href="#/product/${p.id}" class="flex items-center justify-between px-3 py-2 text-xs hover:bg-gray-100 dark:hover:bg-gray-800">
                        <span class="line-clamp-1">${p.name}</span>
                        <span class="text-gray-500 font-semibold">${p.price.toLocaleString()} ₽</span>
                    </a>
                `).join('');
            }
            box.classList.remove('hidden');
        }
        document.addEventListener('click', (e) => {
            const box = document.getElementById('search-suggestions');
            if (box && !box.contains(e.target) && e.target.id !== 'search-input') box.classList.add('hidden');
        });

        function toggleMobileFilters() {
            const sidebar = document.getElementById('catalog-sidebar');
            sidebar.classList.toggle('hidden'); sidebar.classList.toggle('block');
            const btn = document.getElementById('mobile-filters-btn');
            if (btn) btn.setAttribute('aria-expanded', !sidebar.classList.contains('hidden'));
        }

        // ===== PRODUCT MODAL =====
        function openProductModal(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;
            state.selectedModalProduct = product;
            state.selectedModalSize = product.sizes[0];
            document.getElementById('modal-category').innerText = product.category;
            document.getElementById('modal-title').innerText = product.name;
            document.getElementById('modal-price').innerText = `${product.price.toLocaleString()} ₽`;
            document.getElementById('modal-desc').innerText = product.description;
            document.getElementById('modal-details-link').href = `#/product/${product.id}`;
            document.getElementById('modal-sizes').innerHTML = product.sizes.map(size => `
                <button onclick="selectModalSize('${size}', this)" class="modal-size-btn px-4 py-2 border ${size === state.selectedModalSize ? 'border-black dark:border-white font-bold bg-gray-100 dark:bg-gray-800' : 'border-gray-200 dark:border-gray-700'} text-xs rounded">${size}</button>
            `).join('');
            document.getElementById('modal-colors').innerHTML = product.colors.map(c => `<div class="w-6 h-6 rounded-full border border-gray-300" style="background-color:${c}"></div>`).join('');
            document.getElementById('product-modal').classList.remove('hidden');
        }
        function closeProductModal() { document.getElementById('product-modal').classList.add('hidden'); }
        function selectModalSize(size, btn) {
            state.selectedModalSize = size;
            document.querySelectorAll('.modal-size-btn').forEach(b => b.classList.remove('border-black','dark:border-white','font-bold','bg-gray-100','dark:bg-gray-800'));
            btn.classList.add('border-black','dark:border-white','font-bold','bg-gray-100','dark:bg-gray-800');
        }

        // ===== CART =====
        function addToCart(productId, size) {
            const product = products.find(p => p.id === productId);
            if (!product) return;
            const chosenSize = size || product.sizes[0];
            const item = state.cart.find(i => i.id === productId && i.size === chosenSize);
            if (item) item.quantity += 1;
            else state.cart.push({ id: product.id, name: product.name, price: product.price, size: chosenSize, quantity: 1 });
            persistCart(); updateCartUI(); showToast("Товар добавлен в корзину");
        }

        function updateQuantity(id, size, delta) {
            const item = state.cart.find(i => i.id === id && i.size === size);
            if (item) { item.quantity += delta; if (item.quantity <= 0) state.cart = state.cart.filter(i => !(i.id === id && i.size === size)); }
            persistCart(); updateCartUI();
        }

        function cartTotals() {
            const subtotal = state.cart.reduce((s,i) => s + i.price * i.quantity, 0);
            const discount = Math.round(subtotal * (state.discountPercent / 100));
            return { subtotal, discount, total: subtotal - discount };
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const totalCount = state.cart.reduce((s,i) => s + i.quantity, 0);
            const { subtotal, discount, total } = cartTotals();
            document.getElementById('cart-count').innerText = totalCount;
            document.getElementById('cart-subtotal').innerText = `${subtotal.toLocaleString()} ₽`;
            document.getElementById('cart-discount').innerText = `-${discount.toLocaleString()} ₽`;
            document.getElementById('cart-total').innerText = `${total.toLocaleString()} ₽`;

            if (state.cart.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-gray-400"><i class="fa-solid fa-bag-shopping text-4xl mb-3"></i><p class="text-xs">Ваша корзина пуста</p></div>`;
            } else {
                container.innerHTML = state.cart.map(item => `
                    <div class="flex items-center space-x-4 bg-gray-50 dark:bg-gray-800 p-3 rounded-lg">
                        <div class="w-16 h-16 rounded placeholder-card flex items-center justify-center text-white/20"><i class="fa-solid fa-shirt text-xl opacity-40"></i></div>
                        <div class="flex-grow">
                            <h4 class="text-xs font-bold line-clamp-1">${item.name}</h4>
                            <span class="text-[10px] text-gray-400">Размер: ${item.size}</span>
                            <div class="text-xs font-extrabold mt-1">${(item.price * item.quantity).toLocaleString()} ₽</div>
                        </div>
                        <div class="flex items-center space-x-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded px-2 py-1">
                            <button onclick="updateQuantity(${item.id}, '${item.size}', -1)" class="text-xs text-gray-500">−</button>
                            <span class="text-xs font-bold px-1">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, '${item.size}', 1)" class="text-xs text-gray-500">+</button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function toggleCartDrawer() { document.getElementById('cart-drawer').classList.toggle('hidden'); }

        function applyPromoCode() {
            const input = document.getElementById('promo-input').value.trim().toUpperCase();
            if (input === 'URBAN10') { state.discountPercent = 10; showToast("Промокод на 10% применен!"); }
            else { state.discountPercent = 0; showToast("Неверный промокод"); }
            updateCartUI();
        }

        function goToCheckout() {
            if (state.cart.length === 0) { showToast("Корзина пуста"); return; }
            toggleCartDrawer();
            location.hash = '#/checkout';
        }

        function renderCheckout() {
            const items = document.getElementById('checkout-items');
            const { subtotal, discount, total } = cartTotals();
            document.getElementById('checkout-subtotal').innerText = `${subtotal.toLocaleString()} ₽`;
            document.getElementById('checkout-discount').innerText = `-${discount.toLocaleString()} ₽`;
            document.getElementById('checkout-total').innerText = `${total.toLocaleString()} ₽`;
            document.getElementById('checkout-delivery').innerText = 'от 300 ₽';
            items.innerHTML = state.cart.map(i => `
                <div class="flex justify-between gap-2">
                    <span class="line-clamp-1">${i.name} (${i.size}) ×${i.quantity}</span>
                    <span class="font-bold whitespace-nowrap">${(i.price * i.quantity).toLocaleString()} ₽</span>
                </div>
            `).join('') || `<p class="text-gray-400">Корзина пуста</p>`;
        }

        function submitCheckout(e) {
            e.preventDefault();
            if (state.cart.length === 0) { showToast("Корзина пуста"); return; }
            const { total } = cartTotals();
            const orderId = 'UT-' + Date.now().toString().slice(-6);
            const order = {
                id: orderId,
                date: new Date().toLocaleDateString('ru-RU'),
                items: state.cart.map(i => ({ name: i.name, size: i.size, qty: i.quantity, price: i.price })),
                total
            };
            if (currentUser) {
                currentUser.orders = currentUser.orders || [];
                currentUser.orders.unshift(order);
                users[currentUser.email] = currentUser;
                persistUsers();
            }
            state.cart = [];
            state.discountPercent = 0;
            document.getElementById('promo-input').value = '';
            persistCart();
            updateCartUI();
            document.getElementById('success-order-id').innerText = orderId;
            location.hash = '#/success';
        }

        // ===== FAVORITES =====
        function toggleFavorite(id) {
            if (state.favorites.includes(id)) { state.favorites = state.favorites.filter(f => f !== id); showToast("Удалено из избранного"); }
            else { state.favorites.push(id); showToast("Добавлено в избранное"); }
            persistFavorites(); updateFavUI(); renderBestsellers();
            if (state.activeTab === 'catalog') applyFilters();
            if (state.activeTab === 'product' && state.currentProductId) {
                const p = products.find(x => x.id === state.currentProductId);
                if (p) renderProductPage(p);
            }
        }

        function updateFavUI() {
            document.getElementById('fav-count').innerText = state.favorites.length;
            const container = document.getElementById('fav-items-container');
            const favProducts = products.filter(p => state.favorites.includes(p.id));
            if (favProducts.length === 0) container.innerHTML = `<p class="text-center text-xs text-gray-400 py-8">Список избранного пуст</p>`;
            else container.innerHTML = favProducts.map(item => `
                <div class="flex items-center justify-between bg-gray-50 dark:bg-gray-800 p-3 rounded-lg">
                    <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded placeholder-card flex items-center justify-center text-white/20"><i class="fa-solid fa-shirt text-sm opacity-40"></i></div>
                        <div><a href="#/product/${item.id}" onclick="toggleFavoritesModal()" class="text-xs font-bold hover:underline">${item.name}</a><div class="text-xs font-semibold text-gray-500">${item.price.toLocaleString()} ₽</div></div>
                    </div>
                    <button onclick="addToCart(${item.id}, '${item.sizes[0]}')" class="text-xs bg-black text-white dark:bg-white dark:text-black px-3 py-1.5 rounded uppercase font-bold">В корзину</button>
                </div>
            `).join('');
            if (currentUser) { const accFav = document.getElementById('acc-fav-count'); if (accFav) accFav.innerText = state.favorites.length; }
        }

        function toggleFavoritesModal() { document.getElementById('fav-modal').classList.toggle('hidden'); }

        // ===== THEME =====
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('ut_theme', isDark ? 'dark' : 'light');
        }

        // ===== TOAST =====
        let toastTimer;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.remove('translate-y-20','opacity-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.add('translate-y-20','opacity-0'), 3000);
        }

        // ===== FORMS =====
        function handleContactSubmit(e) { e.preventDefault(); showToast("Сообщение успешно отправлено!"); e.target.reset(); }
        function subscribeNewsletter() { showToast("Вы успешно подписались на рассылку!"); }
        function buyOneClick() {
            const p = state.selectedModalProduct;
            if (!p) return;
            addToCart(p.id, state.selectedModalSize);
            closeProductModal();
            showToast(currentUser ? "Заказ оформлен! Смотрите в личном кабинете." : "Товар добавлен. Войдите, чтобы отслеживать заказ.");
        }

        // ===== AUTH =====
        function switchAuthTab(tab) {
            const isLogin = tab === 'login';
            document.getElementById('login-form').classList.toggle('hidden', !isLogin);
            document.getElementById('register-form').classList.toggle('hidden', isLogin);
            document.getElementById('login-error').classList.add('hidden');
            document.getElementById('reg-error').classList.add('hidden');
            const loginBtn = document.getElementById('auth-tab-login');
            const regBtn = document.getElementById('auth-tab-register');
            if (isLogin) {
                loginBtn.classList.add('border-black','dark:border-white','text-black','dark:text-white');
                loginBtn.classList.remove('border-transparent','text-gray-400');
                regBtn.classList.remove('border-black','dark:border-white','text-black','dark:text-white');
                regBtn.classList.add('border-transparent','text-gray-400');
            } else {
                regBtn.classList.add('border-black','dark:border-white','text-black','dark:text-white');
                regBtn.classList.remove('border-transparent','text-gray-400');
                loginBtn.classList.remove('border-black','dark:border-white','text-black','dark:text-white');
                loginBtn.classList.add('border-transparent','text-gray-400');
            }
        }

        function openAuthModal() { document.getElementById('auth-modal').classList.remove('hidden'); switchAuthTab('login'); }
        function closeAuthModal() { document.getElementById('auth-modal').classList.add('hidden'); }
        function handleAccountClick() { currentUser ? openAccountModal() : openAuthModal(); }

        function handleRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value.trim();
            const email = document.getElementById('reg-email').value.trim().toLowerCase();
            const password = document.getElementById('reg-password').value;
            if (users[email]) { document.getElementById('reg-error').classList.remove('hidden'); return; }
            users[email] = { name, email, password, orders: [] };
            currentUser = users[email];
            persistUsers(); closeAuthModal(); updateAccountUI();
            showToast(`Добро пожаловать, ${name}!`);
            e.target.reset();
        }

        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value.trim().toLowerCase();
            const password = document.getElementById('login-password').value;
            if (!users[email] || users[email].password !== password) { document.getElementById('login-error').classList.remove('hidden'); return; }
            currentUser = users[email];
            persistUsers(); closeAuthModal(); updateAccountUI();
            showToast(`С возвращением, ${currentUser.name}!`);
            e.target.reset();
        }

        function logout() {
            currentUser = null;
            persistUsers(); updateAccountUI(); closeAccountModal();
            showToast("Вы вышли из аккаунта");
        }

        function updateAccountUI() {
            const icon = document.getElementById('account-icon');
            const avatar = document.getElementById('account-avatar');
            const btn = document.getElementById('account-btn');
            if (currentUser) {
                if (icon) icon.classList.add('hidden');
                if (avatar) { avatar.classList.remove('hidden'); avatar.classList.add('flex'); avatar.innerText = currentUser.name.charAt(0).toUpperCase(); avatar.style.display = 'flex'; }
                btn.setAttribute('aria-label', 'Личный кабинет: ' + currentUser.name);
            } else {
                if (avatar) { avatar.classList.add('hidden'); avatar.classList.remove('flex'); avatar.style.display = 'none'; }
                if (icon) icon.classList.remove('hidden');
                btn.setAttribute('aria-label', 'Войти в личный кабинет');
            }
            const mobileLabel = document.getElementById('mobile-account-label');
            if (mobileLabel) mobileLabel.innerText = currentUser ? currentUser.name : 'Личный кабинет';
        }

        function openAccountModal() { if (!currentUser) return; renderAccountModal(); document.getElementById('account-modal').classList.remove('hidden'); }
        function closeAccountModal() { document.getElementById('account-modal').classList.add('hidden'); }

        function renderAccountModal() {
            if (!currentUser) return;
            document.getElementById('acc-name').innerText = currentUser.name;
            document.getElementById('acc-email').innerText = currentUser.email;
            const avatarLarge = document.getElementById('acc-avatar-large');
            if (avatarLarge) avatarLarge.innerText = currentUser.name.charAt(0).toUpperCase();
            const orders = currentUser.orders || [];
            const totalSpent = orders.reduce((s,o) => s + o.total, 0);
            document.getElementById('acc-orders-count').innerText = orders.length;
            document.getElementById('acc-fav-count').innerText = state.favorites.length;
            document.getElementById('acc-total-spent').innerText = totalSpent.toLocaleString() + ' ₽';
            const list = document.getElementById('orders-list');
            if (orders.length === 0) list.innerHTML = `<p class="text-xs text-gray-400 py-3 text-center">Пока нет оформленных заказов</p>`;
            else list.innerHTML = orders.map(o => `
                <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-3">
                    <div class="flex justify-between items-center mb-1"><span class="text-xs font-bold">Заказ ${o.id}</span><span class="text-[10px] text-gray-400">${o.date}</span></div>
                    <div class="text-[11px] text-gray-500">${o.items.map(i => `${i.name} (${i.size}) ×${i.qty}`).join(', ')}</div>
                    <div class="text-xs font-extrabold mt-1">${o.total.toLocaleString()} ₽</div>
                </div>
            `).join('');
        }

        function closeMobileMenu() { document.getElementById('mobile-menu').classList.add('hidden'); }

        // ===== GLOBAL EVENTS =====
        function bindGlobalEvents() {
            document.getElementById('mobile-menu-btn').addEventListener('click', () => document.getElementById('mobile-menu').classList.toggle('hidden'));
            document.getElementById('modal-add-cart-btn').addEventListener('click', () => {
                if (state.selectedModalProduct) { addToCart(state.selectedModalProduct.id, state.selectedModalSize); closeProductModal(); }
            });
            document.getElementById('product-modal').addEventListener('click', (e) => { if (e.target.id === 'product-modal') closeProductModal(); });
            document.getElementById('fav-modal').addEventListener('click', (e) => { if (e.target.id === 'fav-modal') toggleFavoritesModal(); });
            document.getElementById('cart-drawer').addEventListener('click', (e) => { if (e.target.id === 'cart-drawer') toggleCartDrawer(); });
            document.getElementById('auth-modal').addEventListener('click', (e) => { if (e.target.id === 'auth-modal') closeAuthModal(); });
            document.getElementById('account-modal').addEventListener('click', (e) => { if (e.target.id === 'account-modal') closeAccountModal(); });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeProductModal();
                    if (!document.getElementById('fav-modal').classList.contains('hidden')) toggleFavoritesModal();
                    if (!document.getElementById('cart-drawer').classList.contains('hidden')) toggleCartDrawer();
                    if (!document.getElementById('auth-modal').classList.contains('hidden')) closeAuthModal();
                    if (!document.getElementById('account-modal').classList.contains('hidden')) closeAccountModal();
                    closeMobileMenu();
                }
            });
        }
    </script>
</body>
</html>
