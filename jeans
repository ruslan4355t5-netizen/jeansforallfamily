<!DOCTYPE html>
<html lang="ru" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="URBAN THREADS — джинсы и базовая нижняя одежда. Плотный деним, мягкий хлопок, доставка по России.">
    <meta name="theme-color" content="#111827">
    <title>URBAN THREADS — Джинсы и нижняя одежда</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { brand: { 50: '#f9fafb', 100: '#f3f4f6', 900: '#111827', accent: '#2563eb' } },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; transition: background-color 0.3s, color 0.3s; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
        .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
        .tab-content { animation: fadeIn 0.35s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        .placeholder-card { background: linear-gradient(135deg, #e5e7eb 0%, #f3f4f6 50%, #d1d5db 100%); }
        .dark .placeholder-card { background: linear-gradient(135deg, #1f2937 0%, #111827 50%, #374151 100%); }
        .skeleton { animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
        .focus-ring:focus { outline: none; box-shadow: 0 0 0 2px #000; }
        .dark .focus-ring:focus { box-shadow: 0 0 0 2px #fff; }
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 min-h-screen flex flex-col justify-between selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:rounded">Перейти к содержимому</a>

    <!-- TOP BAR -->
    <div class="bg-black text-white dark:bg-gray-900 text-xs py-2 px-4 text-center tracking-widest uppercase font-medium">
        БЕСПЛАТНАЯ ДОСТАВКА ОТ 5 000 ₽ | ПРОМОКОД <span class="text-blue-400 font-bold">URBAN10</span> ДАЁТ 10%
    </div>

    <!-- HEADER -->
    <header class="sticky top-0 z-40 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md text-gray-600 hover:text-black dark:text-gray-300 dark:hover:text-white" aria-label="Открыть меню">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>

                <a href="#/" onclick="switchTab('home'); return false;" class="flex-shrink-0">
                    <span class="text-2xl font-black tracking-tighter uppercase dark:text-white">URBAN THREADS</span>
                </a>

                <nav class="hidden md:flex space-x-8 text-sm font-medium tracking-wide" aria-label="Основная навигация">
                    <a href="#/" onclick="switchTab('home'); return false;" class="nav-link text-black dark:text-white border-b-2 border-black dark:border-white pb-1 transition-all" data-tab="home">ГЛАВНАЯ</a>
                    <a href="#/catalog" onclick="switchTab('catalog'); return false;" class="nav-link text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white border-b-2 border-transparent pb-1 transition-all" data-tab="catalog">КАТАЛОГ</a>
                    <a href="#/collections" onclick="switchTab('collections'); return false;" class="nav-link text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white border-b-2 border-transparent pb-1 transition-all" data-tab="collections">КОЛЛЕКЦИИ</a>
                    <a href="#/about" onclick="switchTab('about'); return false;" class="nav-link text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white border-b-2 border-transparent pb-1 transition-all" data-tab="about">О НАС</a>
                    <a href="#/contacts" onclick="switchTab('contacts'); return false;" class="nav-link text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white border-b-2 border-transparent pb-1 transition-all" data-tab="contacts">КОНТАКТЫ</a>
                </nav>

                <div class="flex items-center space-x-2 sm:space-x-3">
                    <div class="relative hidden sm:block">
                        <input type="search" id="search-input" onkeyup="handleSearch(event)" onfocus="showSearchSuggestions()" placeholder="Поиск товаров..." autocomplete="off" aria-label="Поиск" class="w-36 focus:w-56 transition-all duration-300 bg-gray-100 dark:bg-gray-800 text-xs rounded-full py-2 pl-9 pr-4 focus:outline-none focus:ring-1 focus:ring-black dark:focus:ring-white">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-gray-400"></i>
                        <div id="search-suggestions" class="hidden absolute top-full mt-2 right-0 w-72 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg shadow-xl overflow-hidden z-50"></div>
                    </div>

                    <button id="theme-toggle" onclick="toggleTheme()" class="p-2 text-gray-600 hover:text-black dark:text-gray-300 dark:hover:text-white transition" aria-label="Сменить тему">
                        <i class="fa-solid fa-moon text-lg dark:hidden"></i>
                        <i class="fa-solid fa-sun text-lg hidden dark:block text-yellow-400"></i>
                    </button>

                    <button id="account-btn" onclick="handleAccountClick()" class="relative p-2 text-gray-600 hover:text-black dark:text-gray-300 dark:hover:text-white transition" aria-label="Личный кабинет">
                        <i id="account-icon" class="fa-regular fa-user text-lg"></i>
                        <div id="account-avatar" class="hidden w-7 h-7 rounded-full bg-black text-white dark:bg-white dark:text-black items-center justify-center text-[11px] font-extrabold uppercase"></div>
                    </button>

                    <button onclick="toggleFavoritesModal()" class="relative p-2 text-gray-600 hover:text-black dark:text-gray-300 dark:hover:text-white transition" aria-label="Избранное">
                        <i class="fa-regular fa-heart text-lg"></i>
                        <span id="fav-count" class="absolute top-1 right-1 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">0</span>
                    </button>

                    <button onclick="toggleCartDrawer()" class="relative p-2 text-gray-600 hover:text-black dark:text-gray-300 dark:hover:text-white transition" aria-label="Корзина">
                        <i class="fa-solid fa-bag-shopping text-lg"></i>
                        <span id="cart-count" class="absolute top-1 right-1 bg-black dark:bg-white dark:text-black text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">0</span>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobile-menu" class="hidden md:hidden border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-4 pt-2 pb-4 space-y-2">
            <div class="mb-3 relative">
                <input type="search" id="mobile-search-input" onkeyup="handleSearch(event)" placeholder="Поиск товаров..." class="w-full bg-gray-100 dark:bg-gray-800 text-xs rounded-full py-2 pl-9 pr-4 focus:outline-none">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-gray-400"></i>
            </div>
            <a href="#/" onclick="switchTab('home'); closeMobileMenu(); return false;" class="block w-full text-left py-2 text-sm font-medium">ГЛАВНАЯ</a>
            <a href="#/catalog" onclick="switchTab('catalog'); closeMobileMenu(); return false;" class="block w-full text-left py-2 text-sm font-medium">КАТАЛОГ</a>
            <a href="#/collections" onclick="switchTab('collections'); closeMobileMenu(); return false;" class="block w-full text-left py-2 text-sm font-medium">КОЛЛЕКЦИИ</a>
            <a href="#/about" onclick="switchTab('about'); closeMobileMenu(); return false;" class="block w-full text-left py-2 text-sm font-medium">О НАС</a>
            <a href="#/contacts" onclick="switchTab('contacts'); closeMobileMenu(); return false;" class="block w-full text-left py-2 text-sm font-medium">КОНТАКТЫ</a>
            <button onclick="closeMobileMenu(); handleAccountClick()" class="block w-full text-left py-2 text-sm font-medium border-t border-gray-200 dark:border-gray-800 mt-2 pt-3">
                <i class="fa-regular fa-user mr-2"></i> <span id="mobile-account-label">Личный кабинет</span>
            </button>
        </div>
    </header>

    <!-- MAIN -->
    <main id="main-content" class="flex-grow">

        <!-- HOME -->
        <section id="tab-home" class="tab-content">
            <div class="relative bg-gradient-to-br from-gray-900 via-gray-800 to-black text-white h-[75vh] min-h-[500px] max-h-[820px] overflow-hidden flex items-center">
                <div class="absolute inset-0 opacity-30" aria-hidden="true">
                    <div class="absolute -top-20 -left-20 w-96 h-96 rounded-full bg-blue-700/40 blur-3xl"></div>
                    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-gray-500/30 blur-3xl"></div>
                </div>
                <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left w-full">
                    <span class="inline-block bg-white text-black text-xs font-bold uppercase tracking-widest px-3 py-1 mb-4">НОВАЯ КОЛЛЕКЦИЯ 2026</span>
                    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight uppercase leading-none mb-6">ДЖИНСЫ &<br>НИЖНЯЯ ОДЕЖДА</h1>
                    <p class="max-w-xl text-base sm:text-lg text-gray-200 mb-8 font-light">Капсульный гардероб: деним премиум-качества и комфортная базовая нижняя одежда на каждый день.</p>
                    <div class="flex flex-wrap gap-4">
                        <a href="#/catalog" onclick="switchTab('catalog'); return false;" class="bg-white text-black hover:bg-gray-200 px-8 py-4 font-semibold text-xs tracking-widest uppercase transition-all duration-300 shadow-lg hover:shadow-xl">СМОТРЕТЬ КАТАЛОГ</a>
                        <a href="#/catalog?sort=newest" onclick="filterByCollection('new'); return false;" class="border border-white hover:bg-white hover:text-black px-8 py-4 font-semibold text-xs tracking-widest uppercase transition-all duration-300">НОВИНКИ СЕЗОНА</a>
                    </div>
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400 mb-8">Категории каталога</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <a href="#/catalog?cat=Джинсы" onclick="filterByCategory('Джинсы'); return false;" class="group relative h-72 rounded-lg overflow-hidden cursor-pointer bg-gradient-to-br from-indigo-900 via-blue-800 to-gray-900 flex items-end p-6 focus-ring">
                        <i class="fa-solid fa-user-tie absolute top-6 right-6 text-white/20 text-6xl" aria-hidden="true"></i>
                        <div class="relative z-10">
                            <span class="text-white text-2xl font-black uppercase tracking-wide block">Джинсы</span>
                            <span class="text-blue-200 text-xs">Деним, прямые, slim, оверсайз</span>
                        </div>
                    </a>
                    <a href="#/catalog?cat=Нижняя одежда" onclick="filterByCategory('Нижняя одежда'); return false;" class="group relative h-72 rounded-lg overflow-hidden cursor-pointer bg-gradient-to-br from-rose-900 via-pink-800 to-gray-900 flex items-end p-6 focus-ring">
                        <i class="fa-solid fa-shirt absolute top-6 right-6 text-white/20 text-6xl" aria-hidden="true"></i>
                        <div class="relative z-10">
                            <span class="text-white text-2xl font-black uppercase tracking-wide block">Нижняя одежда</span>
                            <span class="text-rose-200 text-xs">Базовые слои, комфорт, хлопок</span>
                        </div>
                    </a>
                </div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <div class="flex justify-between items-end mb-8">
                    <div>
                        <span class="text-xs uppercase tracking-widest font-bold text-gray-400">Популярное</span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight uppercase dark:text-white">Хиты продаж</h2>
                    </div>
                    <a href="#/catalog" onclick="switchTab('catalog'); return false;" class="text-xs font-bold uppercase tracking-widest border-b border-black dark:border-white pb-1 hover:opacity-70 transition">Все товары &rarr;</a>
                </div>
                <div id="home-bestsellers-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6"></div>
            </div>

            <div class="border-t border-b border-gray-200 dark:border-gray-800 my-16 py-12 bg-gray-100/50 dark:bg-gray-900/50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                    <div class="p-4"><i class="fa-solid fa-truck-fast text-2xl mb-4 text-gray-700 dark:text-gray-300"></i><h3 class="font-bold text-sm tracking-wide uppercase mb-2">Быстрая доставка</h3><p class="text-xs text-gray-500 dark:text-gray-400">Бесплатная курьерская доставка по России от 5 000 ₽.</p></div>
                    <div class="p-4"><i class="fa-solid fa-shield-halved text-2xl mb-4 text-gray-700 dark:text-gray-300"></i><h3 class="font-bold text-sm tracking-wide uppercase mb-2">Гарантия качества</h3><p class="text-xs text-gray-500 dark:text-gray-400">Плотный деним и мягкий хлопок — только проверенные ткани.</p></div>
                    <div class="p-4"><i class="fa-solid fa-rotate-left text-2xl mb-4 text-gray-700 dark:text-gray-300"></i><h3 class="font-bold text-sm tracking-wide uppercase mb-2">Удобный возврат</h3><p class="text-xs text-gray-500 dark:text-gray-400">Возврат или обмен в течение 14 дней с момента получения.</p></div>
                </div>
            </div>
        </section>

        <!-- CATALOG -->
        <section id="tab-catalog" class="tab-content hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <nav class="text-xs text-gray-500 mb-4" aria-label="Хлебные крошки">
                <a href="#/" onclick="switchTab('home'); return false;" class="hover:underline">Главная</a> <span class="mx-1">/</span> <span class="text-black dark:text-white">Каталог</span>
            </nav>
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 pb-4 border-b border-gray-200 dark:border-gray-800 gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold uppercase tracking-tight">Каталог товаров</h1>
                    <p class="text-xs text-gray-500 mt-1">Показано <span id="catalog-count">0</span> товаров</p>
                </div>
                <div class="flex items-center space-x-4 w-full md:w-auto justify-between">
                    <button onclick="toggleMobileFilters()" class="md:hidden flex items-center gap-2 border border-gray-300 dark:border-gray-700 px-4 py-2 rounded text-xs uppercase font-medium" aria-expanded="false" aria-controls="catalog-sidebar" id="mobile-filters-btn">
                        <i class="fa-solid fa-sliders"></i> Фильтры
                    </button>
                    <div class="flex items-center space-x-2">
                        <label for="sort-select" class="text-xs text-gray-500 whitespace-nowrap">Сортировка:</label>
                        <select id="sort-select" onchange="applyFilters()" class="bg-gray-100 dark:bg-gray-800 text-xs rounded border-none py-2 px-3 focus:outline-none focus:ring-1 focus:ring-black dark:focus:ring-white">
                            <option value="popular">По популярности</option>
                            <option value="price-asc">Сначала дешевле</option>
                            <option value="price-desc">Сначала дороже</option>
                            <option value="newest">Новинки</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <aside id="catalog-sidebar" class="hidden md:block space-y-6">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Фильтры</span>
                        <button onclick="resetFilters()" class="text-xs text-red-500 hover:underline">Сбросить все</button>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-wider mb-3">Категории</h4>
                        <div class="space-y-2 text-xs" id="category-filters">
                            <label class="flex items-center space-x-2 cursor-pointer"><input type="checkbox" value="Все" checked onchange="applyFilters()" class="rounded filter-category accent-black dark:accent-white"><span>Все категории</span></label>
                            <label class="flex items-center space-x-2 cursor-pointer"><input type="checkbox" value="Джинсы" onchange="applyFilters()" class="rounded filter-category accent-black dark:accent-white"><span>Джинсы</span></label>
                            <label class="flex items-center space-x-2 cursor-pointer"><input type="checkbox" value="Нижняя одежда" onchange="applyFilters()" class="rounded filter-category accent-black dark:accent-white"><span>Нижняя одежда</span></label>
                        </div>
                    </div>
                    <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
                        <h4 class="text-sm font-bold uppercase tracking-wider mb-3">Максимальная цена</h4>
                        <input type="range" id="price-range" min="500" max="15000" step="250" value="15000" oninput="updatePriceLabel(this.value)" onchange="applyFilters()" class="w-full accent-black dark:accent-white" aria-label="Максимальная цена">
                        <div class="flex justify-between text-xs text-gray-500 mt-2"><span>500 ₽</span><span id="price-range-val" class="font-bold text-black dark:text-white">15 000 ₽</span></div>
                    </div>
                    <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
                        <h4 class="text-sm font-bold uppercase tracking-wider mb-3">Размер</h4>
                        <div class="flex flex-wrap gap-2" id="size-filters">
                            <button onclick="toggleSizeFilter(this, 'XS')" class="size-btn px-3 py-1 text-xs border border-gray-300 dark:border-gray-700 rounded hover:border-black dark:hover:border-white">XS</button>
                            <button onclick="toggleSizeFilter(this, 'S')" class="size-btn px-3 py-1 text-xs border border-gray-300 dark:border-gray-700 rounded hover:border-black dark:hover:border-white">S</button>
                            <button onclick="toggleSizeFilter(this, 'M')" class="size-btn px-3 py-1 text-xs border border-gray-300 dark:border-gray-700 rounded hover:border-black dark:hover:border-white">M</button>
                            <button onclick="toggleSizeFilter(this, 'L')" class="size-btn px-3 py-1 text-xs border border-gray-300 dark:border-gray-700 rounded hover:border-black dark:hover:border-white">L</button>
                            <button onclick="toggleSizeFilter(this, 'XL')" class="size-btn px-3 py-1 text-xs border border-gray-300 dark:border-gray-700 rounded hover:border-black dark:hover:border-white">XL</button>
                        </div>
                    </div>
                </aside>

                <div class="md:col-span-3">
                    <div id="catalog-grid" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
                    <div id="catalog-empty" class="hidden text-center py-16">
                        <i class="fa-solid fa-shirt text-4xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500 text-sm">Товары по выбранным фильтрам не найдены.</p>
                        <button onclick="resetFilters()" class="mt-4 px-4 py-2 bg-black text-white dark:bg-white dark:text-black text-xs uppercase tracking-widest rounded">Сбросить фильтры</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRODUCT PAGE -->
        <section id="tab-product" class="tab-content hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <nav class="text-xs text-gray-500 mb-4" aria-label="Хлебные крошки">
                <a href="#/" onclick="switchTab('home'); return false;" class="hover:underline">Главная</a> <span class="mx-1">/</span>
                <a href="#/catalog" onclick="switchTab('catalog'); return false;" class="hover:underline">Каталог</a> <span class="mx-1">/</span>
                <span id="product-breadcrumb" class="text-black dark:text-white">Товар</span>
            </nav>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="placeholder-card rounded-2xl aspect-[3/4] flex items-center justify-center text-white/30">
                    <i class="fa-solid fa-shirt text-8xl"></i>
                </div>
                <div>
                    <span id="product-category" class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Категория</span>
                    <h1 id="product-title" class="text-3xl font-extrabold uppercase tracking-tight mt-1">Название</h1>
                    <div class="text-2xl font-extrabold mt-3" id="product-price">0 ₽</div>
                    <p id="product-desc" class="text-sm text-gray-500 dark:text-gray-400 mt-4 leading-relaxed">Описание</p>

                    <div class="mt-6">
                        <label class="text-xs font-bold uppercase tracking-wider block mb-2">Цвет</label>
                        <div class="flex space-x-2" id="product-colors"></div>
                    </div>

                    <div class="mt-6">
                        <label class="text-xs font-bold uppercase tracking-wider block mb-2">Размер</label>
                        <div class="flex flex-wrap gap-2" id="product-sizes"></div>
                    </div>

                    <div class="mt-8 flex flex-col sm:flex-row gap-3">
                        <button id="product-add-cart-btn" class="flex-grow bg-black text-white dark:bg-white dark:text-black py-4 text-xs font-bold uppercase tracking-widest hover:opacity-80 transition">Добавить в корзину</button>
                        <button onclick="buyOneClick()" class="flex-grow border border-black dark:border-white py-4 text-xs font-bold uppercase tracking-widest hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition">Купить в 1 клик</button>
                    </div>

                    <div class="mt-8 grid grid-cols-3 gap-3 text-center text-[10px] uppercase tracking-wider text-gray-500">
                        <div><i class="fa-solid fa-truck-fast block text-lg mb-1"></i>Доставка 1–3 дня</div>
                        <div><i class="fa-solid fa-rotate-left block text-lg mb-1"></i>Возврат 14 дней</div>
                        <div><i class="fa-solid fa-shield-halved block text-lg mb-1"></i>Гарантия</div>
                    </div>
                </div>
            </div>
